# 🔐 CAPTA LEADS - Environment Configuration

# ═══════════════════════════════════════════════════════════════
# 💳 STRIPE PAYMENT
# ═══════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ═══════════════════════════════════════════════════════════════
# 📧 EMAIL SERVICE (Resend)
# ═══════════════════════════════════════════════════════════════
RESEND_API_KEY=re_your_api_key_here

# ═══════════════════════════════════════════════════════════════
# 🤖 LEAD HUNTING APIs (Optional but recommended)
# ═══════════════════════════════════════════════════════════════
HUNTER_API_KEY=your_hunter_key_here
CLEARBIT_API_KEY=your_clearbit_key_here

# ═══════════════════════════════════════════════════════════════
# 🧠 AI INTEGRATION (Claude API for suggestions)
# ═══════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk_your_anthropic_key_here

# ═══════════════════════════════════════════════════════════════
# 🔧 SERVER CONFIG
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# 🎯 DEFAULT INDUSTRY (can be changed in UI)
# ═══════════════════════════════════════════════════════════════
# Options: generic, cinema, healthcare, tech, ecommerce, real-estate, etc
DEFAULT_INDUSTRY=generic
