# Configurações Locais - CAPTA LEADS

# Porta do servidor
PORT=3000

# Ambiente
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
# Hunter.io API - OBRIGATÓRIO para leads REAIS
# ═══════════════════════════════════════════════════════════════
# Obtenha sua chave em: https://hunter.io/users/sign_up
# 1. Crie uma conta em https://hunter.io
# 2. Vá para: https://hunter.io/account/api
# 3. Copie seu API Key
# 4. Cole aqui:
HUNTER_API_KEY=seu_hunter_api_key_aqui

# ═══════════════════════════════════════════════════════════════
# Clearbit API - OPCIONAL (para enriquecimento de dados)
# ═══════════════════════════════════════════════════════════════
# Obtenha em: https://clearbit.com/
CLEARBIT_API_KEY=seu_clearbit_api_key_aqui

# ═══════════════════════════════════════════════════════════════
# Resend Email - OPCIONAL (para enviar emails em massa)
# ═══════════════════════════════════════════════════════════════
# Obtenha em: https://resend.com/
RESEND_API_KEY=seu_resend_api_key_aqui
FROM_EMAIL=noreply@captaleads.com
FROM_NAME=CAPTA LEADS

# ═══════════════════════════════════════════════════════════════
# Anthropic Claude - OPCIONAL (para IA integrada)
# ═══════════════════════════════════════════════════════════════
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=seu_anthropic_api_key_aqui

# ═══════════════════════════════════════════════════════════════
# Stripe - OPCIONAL (para pagamentos)
# ═══════════════════════════════════════════════════════════════
# Obtenha em: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=seu_stripe_secret_key_aqui
STRIPE_PUBLISHABLE_KEY=seu_stripe_publishable_key_aqui
