{
  "version": 2,
  "name": "capta-leads",
  "public": true,
  "builds": [
    {
      "src": "server-simple.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server-simple.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "deploymentProtection": {
    "enabled": false
  }
}
